; ============================================================
; AERO_AUTOMATION 저널 템플릿
;  - 달러+중괄호 표기(예: aoa 변수)는 케이스마다 자동 치환됩니다.
;  - 포맷 지정 가능: 소수 둘째자리 -> ${aoa:.2f}
;  - 기본 제공 변수: case_name, group, case_dir, project_dir, nprocs
;
;  권장 사용법: Fluent에서 File > Write > Start Journal 로 실제 작업을
;  한 번 녹화한 뒤, 케이스마다 바뀌는 숫자만 변수로 바꿔 쓰세요.
;  (TUI 프롬프트 순서는 Fluent 버전/모델 설정마다 다릅니다)
; ============================================================

/file/read-case "${project_dir}/base.cas.h5"

; 베이스 케이스(base.cas.h5)에 Named Expression 'aoa', 'mach' 를 만들고
; far-field 경계조건을 Mach = mach, flow direction = cos(aoa), sin(aoa) 로
; 연결해 두면 아래 두 줄만으로 해석 조건이 바뀝니다.
/define/named-expressions/edit "aoa" definition "${aoa} [deg]" q
/define/named-expressions/edit "mach" definition "${mach}" q

; Named Expression 대신 경계조건 TUI를 직접 쓰는 경우 계산된 방향 벡터 사용:
;   flow_x = ${flow_x:.6f}, flow_y = ${flow_y:.6f}

; 리포트 파일(Cl, Cd 등)을 케이스 폴더에 저장 (상대경로 = 케이스 폴더)
/solve/report-files/edit "coef-rfile" file-name "coef-rfile.out" q

/solve/initialize/hyb-initialization
/solve/iterate ${iterations}

/file/write-case-data "${case_name}.cas.h5"
/exit yes
